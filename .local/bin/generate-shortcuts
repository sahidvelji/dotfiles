#!/bin/sh
#
# generate-shortcuts - Generate shell aliases and zsh named directories from bookmark files
#
# Purpose:
#   Reads bookmark files (bm-dirs and bm-files) and generates shell aliases, zsh named
#   directories, and other shell configuration. This allows quick navigation and file access
#   via short command aliases.
#
# Usage:
#   generate-shortcuts
#
# Dependencies:
#   - bm-dirs: bookmark file with directory shortcuts (format: shortcut /path/to/dir)
#   - bm-files: bookmark file with file shortcuts (format: shortcut /path/to/file)
#   - envsubst or eval: for expanding shell variables in bookmark files
#
# Output files:
#   - $XDG_CONFIG_HOME/shell/shortcutrc: shell aliases
#   - $XDG_CONFIG_HOME/shell/zshnameddirrc: zsh named directories
#

set -e

bmdirs="${XDG_CONFIG_HOME:-$HOME/.config}/shell/bm-dirs"
bmfiles="${XDG_CONFIG_HOME:-$HOME/.config}/shell/bm-files"

shell_shortcuts="${XDG_CONFIG_HOME:-$HOME/.config}/shell/shortcutrc"
zsh_named_dirs="${XDG_CONFIG_HOME:-$HOME/.config}/shell/zshnameddirrc"

# Validate input files exist
if [ ! -f "$bmdirs" ]; then
	echo "Error: bm-dirs file not found at $bmdirs" >&2
	exit 1
fi

if [ ! -f "$bmfiles" ]; then
	echo "Error: bm-files file not found at $bmfiles" >&2
	exit 1
fi

# Remove and prepare output files
rm -f "$zsh_named_dirs" 2>/dev/null
printf "# vim: filetype=sh\nalias " > "$shell_shortcuts"

# Helper function to expand variables in file contents
expand_vars() {
	if command -v envsubst >/dev/null 2>&1; then
		envsubst < "$1"
	else
		eval "echo \"$(cat "$1")\""
	fi
}

# Format the `directories` file and write to shell_shortcuts and zsh_named_dirs
expand_vars "$bmdirs" | \
awk "!/^\s*#/ && !/^\s*\$/ {gsub(\"\\\s*#.*$\",\"\");
    printf(\"%s=\42cd %s && ll\42 \\\\\n\",\$1,\$2)   >> \"$shell_shortcuts\" ;
    printf(\"hash -d %s=%s/ \n\",\$1,\$2)                 >> \"$zsh_named_dirs\" }"

# Format the `files` file and write to shell_shortcuts and zsh_named_dirs
expand_vars "$bmfiles" | \
awk "!/^\s*#/ && !/^\s*\$/ {gsub(\"\\\s*#.*$\",\"\");
    printf(\"%s=\42\$EDITOR %s\42 \\\\\n\",\$1,\$2)  >> \"$shell_shortcuts\" ;
    printf(\"hash -d %s=%s \n\",\$1,\$2)             >> \"$zsh_named_dirs\" }"
