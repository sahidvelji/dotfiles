#!/bin/sh

# Handle URLs and files on macOS
# Automatically routes content to appropriate applications:
# - Videos/streams: mpv or QuickTime
# - Images: default image viewer
# - PDFs/ebooks: default PDF viewer
# - Audio: download for later playback
# - Local files: open in $EDITOR
# - URLs: open in default browser
#
# Dependencies: curl, open; mpv optional (falls back to `open`)

# Helper function to extract and decode filename from URL
url_filename() {
	basename "$1" | sed 's/%20/ /g'
}

# If no argument given, open browser (for use as $BROWSER)
[ -z "$1" ] && { "$BROWSER"; exit; }

case "$1" in
	*mkv|*webm|*mp4|*youtube.com/watch*|*youtube.com/playlist*|*youtu.be*)
		# mpv is optional; hand off to the system player when it is absent.
		if command -v mpv >/dev/null 2>&1; then
			mpv --quiet "$1" &
		else
			open "$1"
		fi ;;
	*png|*jpg|*jpe|*jpeg|*gif|*pdf|*cbz|*cbr)
		filename="/tmp/$(url_filename "$1")"
		curl --silent --location "$1" > "$filename" && open "$filename" & ;;
	*mp3|*flac|*opus|*mp3?source*)
		# Download for later playback, into ~/Downloads rather than the cwd.
		curl --silent --location --remote-name --output-dir "$HOME/Downloads" "$1" ;;
	*)
		if [ -f "$1" ]; then
			"$EDITOR" "$1"
		else
			open "$1"
		fi ;;
esac
