#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
Generate macOS text replacements plist from CSV.

Purpose:
    Converts a CSV file of text replacement shortcuts into a macOS-compatible
    plist file that can be imported into System Settings > Keyboard > Text
    Replacements.

Usage:
    generate-subs [input.csv] [output.plist]

Arguments:
    input.csv    Path to input CSV file (default: $HOME/Documents/subs.csv)
    output.plist Path to output plist file (default: $HOME/Documents/subs.plist)

Dependencies:
    - python3 (3.6+)
    - csv, plistlib, os, sys (stdlib)
"""

import csv
import os
import sys
import plistlib


def main():
    # Set default paths
    home = os.environ['HOME']
    default_input = os.path.join(home, 'Documents', 'subs.csv')
    default_output = os.path.join(home, 'Documents', 'subs.plist')

    # Parse command-line arguments
    input_path = sys.argv[1] if len(sys.argv) > 1 else default_input
    output_path = sys.argv[2] if len(sys.argv) > 2 else default_output

    try:
        # Read CSV file
        with open(input_path, 'r', encoding='utf-8') as csv_file:
            csvfile = csv.DictReader(csv_file)
            entries = list(csvfile)

        if not entries:
            print(f"Warning: No entries found in {input_path}")
            return

        # Write to plist file
        with open(output_path, 'wb') as plist_file:
            plistlib.dump(entries, plist_file)

        print(f"Successfully converted {len(entries)} text replacement entries")
        print(f"Input:  {input_path}")
        print(f"Output: {output_path}")

    except FileNotFoundError as e:
        print(f"Error: File not found - {e.filename}", file=sys.stderr)
        sys.exit(1)
    except IOError as e:
        print(f"Error: I/O error - {e}", file=sys.stderr)
        sys.exit(1)
    except Exception as e:
        print(f"Error: {e}", file=sys.stderr)
        sys.exit(1)


if __name__ == '__main__':
    main()
