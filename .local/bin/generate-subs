#!/usr/bin/env bash
# Generate a macOS text-replacements plist from a CSV, for manual import into
# System Settings > Keyboard > Text Replacements.
#
# Modern macOS keeps text replacements in a CloudKit-backed Core Data store
# (~/Library/KeyboardServices/TextReplacements.db), NOT in the legacy
# NSUserDictionaryReplacementItems global preference. Writing that preference
# has no effect on what Settings or the input engine actually use, so there is
# no supported way to apply replacements from the command line. The only
# supported writer is the Settings pane itself.
#
# This script therefore emits the drag-to-import plist format (an array of
# <dict>s keyed `shortcut`/`phrase`). To apply it:
#   1. Run this script.
#   2. Open System Settings > Keyboard > Text Replacements.
#   3. Drag the generated .plist file from Finder into the list.
# The import is additive, so clear out stale rows first if you want the CSV to
# be authoritative.
#
# Usage: generate-subs [input.csv] [output.plist]
#   defaults: ~/.config/macos/subs.csv -> ~/subs.plist

set -euo pipefail

SUBS_CSV="${1:-$HOME/.config/macos/subs.csv}"
OUT_PLIST="${2:-$HOME/subs.plist}"

if [[ ! -r "$SUBS_CSV" ]]; then
  echo "Error: cannot read $SUBS_CSV" >&2
  exit 1
fi

awk '
function esc(s,   r) {
  r = s
  gsub(/&/, "\\&amp;", r)   # must run first, before < and >
  gsub(/</, "\\&lt;",  r)
  gsub(/>/, "\\&gt;",  r)
  return r
}
BEGIN {
  print "<?xml version=\"1.0\" encoding=\"UTF-8\"?>"
  print "<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">"
  print "<plist version=\"1.0\">"
  print "<array>"
}
NR == 1          { next }   # skip header
/^[[:space:]]*$/ { next }   # skip blank lines
{
  c = index($0, ",")        # split on the first comma only
  if (c == 0) next
  shortcut = substr($0, 1, c - 1)
  phrase   = substr($0, c + 1)
  sub(/\r$/, "", phrase)                              # tolerate CRLF
  gsub(/^[[:space:]]+|[[:space:]]+$/, "", shortcut)   # trim shortcut
  if (shortcut == "") next
  n++
  print "\t<dict>"
  print "\t\t<key>shortcut</key>"
  print "\t\t<string>" esc(shortcut) "</string>"
  print "\t\t<key>phrase</key>"
  print "\t\t<string>" esc(phrase) "</string>"
  print "\t</dict>"
}
END {
  print "</array>"
  print "</plist>"
  printf "Generated %d entries\n", n > "/dev/stderr"
}
' "$SUBS_CSV" > "$OUT_PLIST"

echo "Wrote $OUT_PLIST"
echo "Import: System Settings > Keyboard > Text Replacements, then drag the file in."
