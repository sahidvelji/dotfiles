# fetching

auto-reload yes
reload-time 60
reload-threads 8
refresh-on-startup yes
error-log "~/.local/state/newsboat/error.log"

# retention

max-items 200
cleanup-on-quit yes

# reading

text-width 80
scrolloff 3
save-path "~/Downloads"
confirm-exit no
goto-next-feed no
article-sort-order date-asc
feed-sort-order unreadarticlecount-asc

# display

feedlist-format    "%4i %n %11u %t"
articlelist-format "%4i %f %D %?T?|%-17T| ?%t"
datetime-format    "%Y-%m-%d"

# keybindings

bind-key j down
bind-key k up
bind-key j next articlelist
bind-key k prev articlelist
bind-key J next-feed articlelist
bind-key K prev-feed articlelist
bind-key G end
bind-key g home
bind-key d pagedown
bind-key u pageup
bind-key l open
bind-key h quit
bind-key a toggle-article-read
bind-key n next-unread
bind-key N prev-unread
bind-key U show-urls

# colors

color listnormal cyan default
color listfocus black yellow standout bold
color listnormal_unread blue default
color listfocus_unread yellow default bold
color info red black bold
color article white default bold

# highlights

highlight all "---.*---" yellow
highlight feedlist ".*(0/0))" black
highlight article "(^Feed:.*|^Title:.*|^Author:.*)" cyan default bold
highlight article "(^Link:.*|^Date:.*)" default default
highlight article "https?://[^ ]+" green default
highlight article "^(Title):.*$" blue default
highlight article "\\[[0-9][0-9]*\\]" magenta default bold
highlight article "\\[image\\ [0-9]+\\]" green default bold
highlight article "\\[embedded flash: [0-9][0-9]*\\]" green default bold
highlight article ":.*\\(link\\)$" cyan default
highlight article ":.*\\(image\\)$" blue default
highlight article ":.*\\(embedded flash\\)$" magenta default

# browser and macros

browser "link-handler %u"

macro , open-in-browser -- "open"
macro b set browser "open --background %u"; open-in-browser-and-mark-read; set browser "link-handler %u" -- "open in a background tab"
macro c set browser "echo %u | pbcopy"; open-in-browser; set browser "link-handler %u" -- "copy the link"
macro o set browser "open --reveal %u"; open-in-browser; set browser "link-handler %u" -- "reveal in Finder"
