#!/usr/bin/env bash
#MISE description="Refresh default branches under ~/repos and prune merged local branches"
#USAGE flag "-j --jobs <jobs>" help="Repos to tidy in parallel" default="4"
#USAGE flag "-a --all" help="Tidy every repo even when run from inside one"
#USAGE flag "-n --dry-run" help="Report what would change without deleting branches"
#
# Walks every git repo directly under ~/repos and, for each one:
#   - fetches with --prune, so remote-tracking refs for deleted branches go away
#   - fast-forwards the default branch (skipped when the worktree is dirty, and
#     done without a checkout when the repo is sitting on a feature branch)
#   - hands local-branch pruning to gh-poi, which deletes branches whose PR has
#     merged or closed
#
# Run from inside a repo it tidies only that repo; pass --all for the full walk.

set -uo pipefail

REPOS_ROOT="${REPOS_ROOT:-$HOME/repos}"

# Tidy one repo and print a single summary line. Run as a child process by the
# xargs fan-out below, so it must not depend on mise's usage_* environment.
if [[ "${1-}" == "__one" ]]; then
	repo="$2"
	dry_run="$3"
	name="${repo##*/}"
	status=()

	cd "$repo" || exit 0

	if ! git fetch --prune --quiet 2>/dev/null; then
		printf '%-24s fetch failed\n' "$name"
		exit 0
	fi

	# origin/HEAD is only written at clone time and can go stale or missing;
	# --auto re-resolves it against the remote.
	default="$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null)"
	if [[ -z $default ]]; then
		git remote set-head origin --auto >/dev/null 2>&1
		default="$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null)"
	fi
	if [[ -z $default ]]; then
		printf '%-24s no origin/HEAD\n' "$name"
		exit 0
	fi
	default="${default#origin/}"

	current="$(git symbolic-ref --quiet --short HEAD 2>/dev/null)"

	if [[ $current == "$default" ]]; then
		if [[ -n "$(git status --porcelain)" ]]; then
			status+=("dirty, $default not pulled")
		elif git merge --ff-only --quiet "origin/$default" 2>/dev/null; then
			status+=("$default up to date")
		else
			status+=("$default diverged")
		fi
	else
		# Fetching from "." moves the local branch to match the already-fetched
		# remote ref with no checkout and no second network round trip. Without
		# --force this refuses anything that is not a fast-forward.
		if git fetch --quiet . "refs/remotes/origin/$default:refs/heads/$default" 2>/dev/null; then
			status+=("$default fast-forwarded, on $current")
		else
			status+=("$default diverged, on $current")
		fi
	fi

	poi_args=()
	[[ $dry_run == 1 ]] && poi_args+=(--dry-run)
	if poi_out="$(gh-poi "${poi_args[@]}" 2>&1)"; then
		# Under "Deleted branches" gh-poi prints one indented line per branch,
		# or the sentinel "There are no branches ..." when it removed nothing.
		deleted="$(printf '%s\n' "$poi_out" |
			sed -n '/^Deleted branches$/,/^$/p' |
			grep -E '^  [^ ]' |
			grep -cv 'There are no branches' || true)"
		((deleted > 0)) && status+=("$deleted branch(es) pruned")
	else
		status+=("gh-poi failed")
	fi

	printf '%-24s %s\n' "$name" "$(
		IFS='; '
		echo "${status[*]}"
	)"
	exit 0
fi

jobs="${usage_jobs:-4}"
all="${usage_all:-false}"
dry_run=0
[[ ${usage_dry_run:-false} == "true" ]] && dry_run=1

command -v gh-poi >/dev/null || {
	echo "repos-tidy: gh-poi is not installed (mise install)" >&2
	exit 1
}

# Scope to the current repo unless --all, so running this mid-task does not
# touch every checkout on the machine.
repos=()
if [[ $all != "true" ]] && toplevel="$(git rev-parse --show-toplevel 2>/dev/null)"; then
	repos=("$toplevel")
else
	for dir in "$REPOS_ROOT"/*/; do
		[[ -d "${dir}.git" ]] && repos+=("${dir%/}")
	done
fi

if ((${#repos[@]} == 0)); then
	echo "repos-tidy: no git repos found under $REPOS_ROOT" >&2
	exit 1
fi

# xargs re-invokes this script per repo, so resolve it to an absolute path:
# mise may hand us a relative $0 and the children inherit whatever cwd it set.
self="$(cd "$(dirname "$0")" && pwd -P)/$(basename "$0")"

[[ $dry_run == 1 ]] && echo "== DRY RUN =="
printf '%s\0' "${repos[@]}" |
	xargs -0 -P "$jobs" -I{} "$self" __one {} "$dry_run"
