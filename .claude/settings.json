{
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "opus",
  "statusLine": {
    "type": "command",
    "command": "sh \"$HOME/.claude/statusline-command.sh\"",
    "refreshInterval": 10
  },
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "theme": "auto",
  "timeFormat": "24-hour",
  "maxProseWidth": 72,
  "outputStyle": "Concise",
  "editorMode": "vim",
  "autoCompactEnabled": true,
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "attribution": {
    "sessionUrl": false
  },
  "fallbackModel": [
    "sonnet"
  ],
  "autoContinueAtUsageLimit": true,
  "voiceEnabled": true
}
