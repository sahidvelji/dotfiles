#!/usr/bin/env bash
#MISE description="Write the git checkouts under ~/repos to conf.d/repos.toml for mise bootstrap to clone"
#USAGE flag "-n --dry-run" help="Print the generated file instead of writing it"
#
# Records each git repo directly under ~/repos as a [bootstrap.repos] entry,
# so `mise bootstrap` clones it on a new machine. Only each repo's origin URL
# is recorded: uncommitted work, unpushed branches and other remotes (such as
# a fork's upstream) are not restored.
#
# The table lives in its own conf.d file so config.toml stays hand-written.
# It writes the repo copy, so it works before ~/.config/mise is linked.
#
# A plain glob finds the repos rather than fd, which honours ignore files and
# would skip a repo whose own .gitignore matches .git.

set -euo pipefail

dest="$HOME/repos/dotfiles/config/mise/conf.d/repos.toml"

# dotfiles is cloned by hand before the first bootstrap.
skip=(dotfiles)

entries=()
for dir in "$HOME"/repos/*/; do
  dir="${dir%/}"
  name="${dir##*/}"
  [[ -d "$dir/.git" ]] || continue
  [[ " ${skip[*]} " == *" $name "* ]] && continue
  url="$(git -C "$dir" remote get-url origin 2>/dev/null)" || continue
  entries+=("\"~/repos/$name\" = { url = \"$url\" }")
done

if ((${#entries[@]} == 0)); then
  echo "capture:repos: no git repos with an origin under ~/repos" >&2
  exit 1
fi

render() {
  echo '# Generated by "mise run capture:repos"; do not edit by hand.'
  echo '[bootstrap.repos]'
  printf '%s\n' "${entries[@]}" | LC_ALL=C sort
}

if [[ ${usage_dry_run:-false} == "true" ]]; then
  render
  exit 0
fi

mkdir -p "${dest%/*}"
render >"$dest"
echo "capture:repos: wrote ${#entries[@]} repos to $dest"
