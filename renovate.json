{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "minimumReleaseAge": "3 days",
  "automerge": true,
  "platformAutomerge": false,
  "ignorePaths": [
    "config/mise/config.toml"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Bump the hk package URLs in hk.pkl, which Renovate has no manager for. depName matches the mise dep, so both share one branch.",
      "managerFilePatterns": [
        "**/hk.pkl"
      ],
      "matchStrings": [
        "github\\.com/jdx/hk/releases/download/v(?<currentValue>[\\d.]+)/hk@[\\d.]+"
      ],
      "autoReplaceStringTemplate": "github.com/jdx/hk/releases/download/v{{{newValue}}}/hk@{{{newValue}}}",
      "depNameTemplate": "hk",
      "packageNameTemplate": "jdx/hk",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)"
    }
  ]
}
